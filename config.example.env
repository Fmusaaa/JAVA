BOT_USERNAME=your_bot_username
BOT_TOKEN=your_bot_token

# SQLITE is the default and stores data in taskbot.db.
DB_TYPE=SQLITE
DB_URL=jdbc:sqlite:taskbot.db

# For MySQL, create the database first, then use:
# DB_TYPE=MYSQL
# DB_URL=jdbc:mysql://localhost:3306/taskbot?useSSL=false&serverTimezone=Asia/Jakarta
# DB_USERNAME=your_mysql_user
# DB_PASSWORD=your_mysql_password

REMINDER_INTERVAL_MINUTES=1

# Optional AI parser. Use STUB to disable real API calls.
# When GEMINI is enabled, natural messages can create tasks and /ask becomes an AI assistant.
AI_PROVIDER=STUB
# AI_PROVIDER=GEMINI
# GEMINI_API_KEY=your_gemini_api_key
# AI_MODEL=gemini-2.5-flash-lite
